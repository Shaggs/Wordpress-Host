PLATFORM_NAME="WP Host"
PLATFORM_TITLE="WP Host WordPress Hosting"
MANAGER_DOMAIN="hosting.example.com"

WP_HOST_DIR=/opt/wp-host
WP_SITES_DIR=/opt/wp-host/sites
WP_BACKUP_DIR=/opt/wp-host/backups
WP_PROXY_NETWORK=wp-proxy
WP_DASHBOARD_PORT=8088

WP_DASHBOARD_USER=admin
WP_DASHBOARD_EMAIL=admin@example.com
WP_DASHBOARD_PASSWORD_HASH=GENERATED_BY_INSTALLER
WP_DASHBOARD_PASSWORD_SALT=GENERATED_BY_INSTALLER
WP_FLASK_SECRET=GENERATED_BY_INSTALLER

WP_NPM_URL=http://127.0.0.1:81
WP_NPM_EMAIL=admin@example.com
WP_NPM_PASSWORD=GENERATED_BY_INSTALLER
WP_LE_EMAIL=admin@example.com
